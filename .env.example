# ─── Anthropic ───────────────────────────────────────────────
# Your master Anthropic API key. NEVER expose this to buyers.
ANTHROPIC_MASTER_KEY=sk-ant-...

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key, not anon

# ─── Upstash Redis ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Pricing ─────────────────────────────────────────────────
# Anthropic's current prices in USD per million tokens
ANTHROPIC_INPUT_PRICE_PER_M=3.00
ANTHROPIC_OUTPUT_PRICE_PER_M=15.00
# Your markup multiplier (1.20 = 20% above cost → buyer pays $3.60/$18.00)
PLATFORM_MARKUP=1.20
# Platform fee taken from seller earnings (0.02 = 2%)
PLATFORM_FEE=0.02

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
